---
import { Image } from "astro:assets";
import logoWhite from "../assets/logo_white.png";
const year = new Date().getFullYear();
const links = [
  { href: "/#bio", label: "Sobre mí" },
  { href: "/#libro", label: "Libro" },
  { href: "/#podcast", label: "Podcast" },
  { href: "/#eventos", label: "Eventos" },
  { href: "/#retiros", label: "Retiros" },
  { href: "/#contacto", label: "Contacto" },
  { href: "/about", label: "Mi historia" },
];
---

<footer class="footer" data-surface="noche">
  <div class="container footer__grid">
    <a href="/" class="footer__logo" aria-label="María Alejandra Ruiz — inicio">
      <Image src={logoWhite} alt="" width={480} densities={[1, 2]} loading="lazy" />
    </a>
    <nav class="footer__nav" aria-label="Pie de página">
      <ul>
        {links.map((l) => <li><a class="link link--quiet" href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>
    <div class="footer__meta">
      <p class="caption">© {year} Dra. María Alejandra Ruiz. Todos los derechos reservados.</p>
      <p class="caption">Tampa, Florida · Online · <a class="footer__legal" href="/privacidad">Política de privacidad</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--rule);
    padding-block: clamp(40px, 6vw, 72px) 32px;
  }
  .footer__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 40px;
    align-items: end;
  }
  .footer__logo {
    grid-column: 1 / span 5;
    display: block;
    max-width: 320px;
  }
  .footer__logo img {
    width: 100%;
    height: auto;
  }
  .footer__nav {
    grid-column: 7 / span 6;
    justify-self: end;
  }
  .footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    font-size: 0.875rem;
    justify-content: flex-end;
  }
  .footer__meta {
    grid-column: 1 / -1;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .footer__legal {
    display: inline-block;
    padding-block: 8px;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: color var(--dur-instant) ease;
  }
  .footer__legal:hover {
    color: var(--fg);
  }
  @media (max-width: 899px) {
    .footer__logo { grid-column: 1 / -1; max-width: 260px; }
    .footer__nav { grid-column: 1 / -1; justify-self: start; }
    .footer__nav ul { justify-content: flex-start; }
  }
</style>

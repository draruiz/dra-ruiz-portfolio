---
import heroVideo from "../assets/hero_video.mp4";
import heroVideoMobile from "../assets/hero_video_mobile.mp4";
import Thread from "./Thread.astro";
---

<section id="inicio" class="hero" data-surface="noche" aria-label="Presentación">
  <div class="hero__media" aria-hidden="true">
    <!-- La versión móvil es el mismo metraje recortado a vertical sobre el mismo punto
         focal (62 %), así el encuadre coincide con el póster y pesa la cuarta parte. -->
    <video
      class="hero__video"
      muted
      loop
      playsinline
      preload="none"
      data-src={heroVideo}
      data-src-mobile={heroVideoMobile}
      poster="/hero-poster.jpg"
      tabindex="-1"></video>
  </div>

  <Thread class="hero__thread" draw="hero" width={1.5} d="M -20 170 C 300 70, 520 430, 820 340 C 1040 270, 1250 430, 1180 920" dot={{ cx: 1192, cy: 790 }} />

  <div class="container hero__body">
    <h1 class="hero__name display-1">
      <span class="hero__line" data-hero>María</span>
      <span class="hero__line" data-hero>Alejan<span class="script">dra</span></span>
      <span class="hero__line" data-hero><span class="script">R</span>uiz</span>
    </h1>

    <div class="hero__aside">
      <p class="hero__role kicker" data-hero>Psicóloga clínica · Autora · Conferencista</p>
      <p class="hero__lede body-lg" data-hero>
        Más de diez años acompañando a personas y equipos a entender sus vínculos: apego, ansiedad y
        dependencia emocional, con rigor clínico y en español.
      </p>
      <div class="hero__actions" data-hero>
        <a class="btn btn--primary" href="https://almaymente.io" target="_blank" rel="noopener noreferrer">Ver los cursos</a>
        <a class="link" href="https://wa.me/18135686424?text=Hola%20Dra.%20Ruiz%2C%20me%20gustar%C3%ADa%20ponerme%20en%20contacto%20con%20usted." target="_blank" rel="noopener noreferrer">Escríbeme</a>
      </div>
    </div>
  </div>

  <div class="container hero__foot" data-hero>
    <span class="caption">Tampa, Florida · Online</span>
    <a class="caption hero__scroll" href="#indice">Índice</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto auto;
    padding-top: var(--nav-h);
    overflow: clip;
    isolation: isolate;
  }
  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: var(--negro);
  }
  /* el poster (fotograma del propio video) se ve siempre; el video entra encima al reproducirse */
  .hero__media::before {
    content: "";
    position: absolute;
    inset: 0;
    background: url("/hero-poster.jpg") 62% 40% / cover no-repeat;
  }
  .hero__video {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% 40%;
    opacity: 0;
    transition: opacity var(--dur-slow) ease;
  }
  .hero__video.is-playing {
    opacity: 1;
  }
  /* capa de protección para el texto: nunca se confía en la foto */
  .hero__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.78) 0%,
      rgba(0, 0, 0, 0.42) 48%,
      rgba(0, 0, 0, 0.5) 100%
    );
  }
  .hero__thread {
    z-index: 1;
  }
  .hero__body {
    position: relative;
    z-index: 2;
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 40px;
    align-items: end;
    padding-bottom: clamp(32px, 5vh, 64px);
  }
  .hero__name {
    grid-column: 1 / span 8;
    display: grid;
    margin-left: -0.04em;
  }
  .hero__line {
    display: block;
  }
  .hero__line .script {
    position: relative;
    top: 0.02em;
  }
  .hero__aside {
    grid-column: 9 / -1;
    display: grid;
    gap: 20px;
    padding-bottom: 0.4em;
  }
  .hero__role {
    color: var(--accent);
    display: block;
    line-height: 1.5;
    text-wrap: balance;
  }
  .hero__lede {
    color: var(--fg-muted);
    max-width: 30rem;
  }
  .hero__actions {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-wrap: wrap;
  }
  .hero__foot {
    position: relative;
    z-index: 2;
    grid-row: 3;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-block: 20px 24px;
    border-top: 1px solid var(--rule);
  }
  .hero__scroll {
    color: var(--fg-muted);
    transition: color var(--dur-instant) ease;
  }
  .hero__scroll:hover {
    color: var(--fg);
  }

  /* entrada coordinada tras el preloader (solo con JS) */
  :global(.js) [data-hero] {
    opacity: 0;
    transform: translateY(24px);
  }

  @media (max-width: 899px) {
    .hero__thread :global(.thread__dot) {
      display: none;
    }
    .hero__body {
      row-gap: 32px;
    }
    .hero__name {
      grid-column: 1 / -1;
    }
    .hero__aside {
      grid-column: 1 / -1;
      padding-bottom: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-hero] {
      opacity: 1;
      transform: none;
    }
  }
</style>

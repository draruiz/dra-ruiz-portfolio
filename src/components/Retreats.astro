---
import Thread from "./Thread.astro";
const wa = "https://wa.me/18135686424?text=Hola%20Dra.%20Ruiz%2C%20me%20interesa%20informaci%C3%B3n%20sobre%20los%20retiros%20terap%C3%A9uticos.";
---

<section id="retiros" class="retreats section" data-surface="tension" aria-labelledby="retreats-heading">
  <Thread class="retreats__thread" draw="scrub" d="M 220 -10 C 220 320, 500 620, 800 560 S 990 620, 985 761 C 980 880, 1200 830, 1200 910" dm="M 40 -10 C 40 300, 64 460, 40 680 S 30 820, 40 910" dot={{ cx: 985, cy: 761 }} anchor=".retreats__text .btn" />

  <div class="container retreats__grid">
    <p class="retreats__word script" aria-hidden="true" data-reveal>calma</p>

    <div class="retreats__text">
      <p class="kicker kicker--rule" data-reveal>Retiros terapéuticos</p>
      <h2 id="retreats-heading" class="display-2" data-reveal style="--i:1">
        Espacios de sanación y reconexión en la naturaleza
      </h2>
      <p class="body-lg" data-reveal style="--i:2">
        Retiros inmersivos de tres a cinco días que integran psicología clínica, mindfulness, yoga y conexión
        con la naturaleza para promover la sanación profunda y el autoconocimiento.
      </p>
      <ul class="rules retreats__list" data-reveal style="--i:3">
        <li>Terapia grupal guiada</li>
        <li>Yoga y meditación</li>
        <li>Respiración consciente</li>
        <li>Caminatas terapéuticas</li>
      </ul>
      <p data-reveal style="--i:4">
        Los cupos son limitados para garantizar una experiencia íntima. Escríbenos para conocer las próximas
        fechas.
      </p>
      <a class="btn btn--primary" href={wa} target="_blank" rel="noopener noreferrer" data-reveal style="--i:5">Reservar mi lugar</a>
    </div>
  </div>
</section>

<style>
  .retreats {
    min-height: 100svh;
    display: grid;
    align-items: center;
  }
  .retreats__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 40px;
    align-items: center;
  }
  /* la palabra del manual: una sola, en script, en rosa sobre rojo (≥24px) */
  .retreats__word {
    grid-column: 1 / span 6;
    position: relative;
    z-index: 3;
    color: var(--rosa);
    font-size: clamp(6rem, 16vw, 15rem);
    line-height: 0.8;
    margin-left: -0.02em;
    max-width: none;
  }
  .retreats__text {
    grid-column: 7 / -1;
    position: relative;
    z-index: 2;
    display: grid;
    gap: 22px;
    justify-items: start;
  }
  .retreats__text .body-lg,
  .retreats__text p:not(.kicker):not(.body-lg) { color: var(--fg-muted); }
  .retreats__list {
    width: 100%;
    max-width: 28rem;
    columns: 2;
    column-gap: var(--gap);
    border-top: 0;
  }
  .retreats__list > li { break-inside: avoid; border-top: 1px solid var(--rule); border-bottom: 0; }
  @media (max-width: 899px) {
    .retreats__word { grid-column: 1 / -1; font-size: clamp(5.5rem, 28vw, 11rem); }
    .retreats__text { grid-column: 1 / -1; }
    .retreats__list { columns: 1; }
  }
</style>

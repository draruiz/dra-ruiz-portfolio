---
import { Image } from "astro:assets";
import Thread from "./Thread.astro";
import diloCover from "../assets/dilo-como-es.jpg"; // portada oficial del show (oEmbed de Spotify)
const ytId = "-XgVfoCTgGQ";
---

<section id="podcast" class="media section" data-surface="papel" aria-labelledby="media-heading">
  <Thread class="media__thread" draw="scrub" d="M 300 -10 C 300 230, 600 340, 800 290 S 1000 180, 1000 910" dm="M 40 -10 C 40 300, 60 500, 40 700 S 30 850, 40 910" />

  <div class="container">
    <header class="media__head">
      <p class="kicker kicker--rule" data-reveal>Podcast & Media</p>
      <h2 id="media-heading" class="display-2" data-reveal style="--i:1">
        Conversaciones <span class="script">honestas</span> sobre salud mental
      </h2>
    </header>

    <div class="media__grid">
      <article class="media__item media__item--spotify" data-reveal>
        <button
          class="facade facade--spotify"
          type="button"
          data-embed="spotify"
          aria-label="Reproducir el podcast Dilo Como Es en Spotify"
        >
          <Image src={diloCover} alt="" width={640} class="facade__img" loading="lazy" decoding="async" />
          <span class="facade__tags label">Relaciones · Rupturas · Autoestima</span>
          <span class="facade__brand label">Podcast · Spotify</span>
          <span class="facade__title">Dilo Como Es</span>
          <span class="facade__host body-sm">con Lily Taveras</span>
          <span class="facade__play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
          </span>
        </button>
        <h3 class="h3">Dilo Como Es</h3>
        <p class="body-sm">
          Junto a Lily Taveras, actriz e influencer, una mirada honesta y sincera sobre relaciones, rupturas y
          autoestima. Sabiduría profesional y autenticidad en cada episodio.
        </p>
        <a class="link" href="https://open.spotify.com/show/7EAPPcMUumoRKNNJd44f6k" target="_blank" rel="noopener noreferrer">Abrir en Spotify</a>
      </article>

      <article class="media__item media__item--yt" data-reveal style="--i:1">
        <button
          class="facade facade--yt"
          type="button"
          data-embed="youtube"
          data-id={ytId}
          aria-label="Reproducir video del canal de YouTube de la Dra. Ruiz"
        >
          <img
            src={`https://i.ytimg.com/vi/${ytId}/hqdefault.jpg`}
            alt=""
            width="480"
            height="360"
            loading="lazy"
            decoding="async"
          />
          <span class="facade__play" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="M8 5.5v13l11-6.5z" /></svg>
          </span>
        </button>
        <h3 class="h3">Canal oficial en YouTube</h3>
        <p class="body-sm">
          Conversaciones, reflexiones y herramientas prácticas sobre salud mental y bienestar emocional.
          Contenido gratuito para acompañarte en tu proceso.
        </p>
        <a class="link" href="https://www.youtube.com/@Pensandoenvozaltadraruiz/videos" target="_blank" rel="noopener noreferrer">Ver el canal</a>
      </article>
    </div>
  </div>
</section>

<style>
  .media__head {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 24px;
    max-width: 52rem;
    margin-bottom: clamp(48px, 6vw, 88px);
  }
  .media__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 56px;
    align-items: start;
  }
  .media__item {
    display: grid;
    gap: 14px;
    justify-items: start;
  }
  .media__item--spotify { grid-column: 1 / span 7; }
  .media__item--yt { grid-column: 8 / span 5; padding-top: clamp(0px, 6vw, 96px); }
  .media__item .h3 { margin-top: 10px; }
  .media__item > .body-sm { color: var(--fg-muted); max-width: 30rem; }

  /* Fachada: el iframe solo se carga al hacer click */
  .facade {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-lg);
    overflow: hidden;
    display: grid;
    align-content: end;
    justify-items: start;
    gap: 8px;
    padding: 28px;
    text-align: left;
    background: var(--negro);
    color: var(--crema);
    border: 1px solid var(--rule);
  }
  .facade--yt {
    padding: 0;
    aspect-ratio: 16 / 9;
  }
  .facade--spotify {
    aspect-ratio: 16 / 9;
  }
  /* portada real del show en B/N + capa de protección para el texto (manual §12) */
  .facade__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter var(--dur-slow) ease;
  }
  .facade--spotify::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.82) 0%, rgba(0, 0, 0, 0.35) 45%, rgba(0, 0, 0, 0.25) 100%);
  }
  .facade--spotify > span:not(.facade__tags) {
    position: relative;
    z-index: 1;
  }
  .facade--spotify .facade__tags {
    z-index: 1;
  }
  .facade--yt img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: filter var(--dur-slow) ease;
  }
  .facade__brand,
  .facade__tags {
    color: rgba(254, 244, 235, 0.72);
  }
  .facade__tags {
    position: absolute;
    top: 28px;
    left: 28px;
  }
  .facade__host {
    color: rgba(254, 244, 235, 0.72);
    margin-top: 2px;
  }
  .facade__title {
    font-size: clamp(2.25rem, 4.6vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .facade__play {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--crema);
    color: var(--rojo);
    transition: transform 160ms var(--ease-out);
  }
  .facade--yt .facade__play {
    top: 50%;
    left: 50%;
    right: auto;
    transform: translate(-50%, -50%);
  }
  .facade__play svg { margin-left: 2px; }
  .facade:active .facade__play { transform: scale(0.94); }
  .facade--yt:active .facade__play { transform: translate(-50%, -50%) scale(0.94); }
  @media (hover: hover) and (pointer: fine) {
    .facade--yt:hover img,
    .facade--spotify:hover .facade__img { filter: grayscale(0) contrast(1); }
  }
  :global(.embed) {
    width: 100%;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--negro);
  }
  :global(.embed--yt) {
    aspect-ratio: 16 / 9;
    position: relative;
  }
  :global(.embed--yt iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  :global(.embed iframe) {
    display: block;
    border: 0;
  }

  @media (max-width: 899px) {
    .media__item--spotify,
    .media__item--yt { grid-column: 1 / -1; padding-top: 0; }
    .facade { padding: 20px; }
    .facade__tags { top: 20px; left: 20px; }
  }
  @media (max-width: 599px) {
    .facade__tags { display: none; }
  }
</style>

---
import Thread from "./Thread.astro";
const wa = "https://wa.me/18135686424?text=Hola%20Dra.%20Ruiz%2C%20me%20gustar%C3%ADa%20ponerme%20en%20contacto%20con%20usted.";
const socials = [
  { href: "https://www.instagram.com/dramariaalejandraruiz/", label: "Instagram" },
  { href: "https://www.youtube.com/@Pensandoenvozaltadraruiz/videos", label: "YouTube" },
  { href: "https://www.linkedin.com/in/drmarialejandraruiz", label: "LinkedIn" },
];
---

<section id="contacto" class="contact section" data-surface="noche" aria-labelledby="contact-heading">
  <Thread class="contact__thread" draw="scrub" d="M 1200 -10 C 1200 320, 760 448, 84 448" dm="M 40 -10 L 40 500" dot={{ cx: 84, cy: 448 }} anchor=".contact__mail" anchorPos="end" />

  <div class="container contact__inner">
    <p class="kicker kicker--rule" data-reveal>Contacto</p>
    <h2 id="contact-heading" class="display-2" data-reveal style="--i:1">Hablemos.</h2>
    <p class="body-lg contact__lede" data-reveal style="--i:2">
      Si te interesan las conferencias, los talleres, los retiros o una consulta, escríbeme.
    </p>
    <a class="contact__mail" href="mailto:info@draalejandraruiz.com" data-reveal style="--i:3">
      info@draalejandraruiz.com
    </a>

    <div class="contact__grid">
      <div data-reveal style="--i:4">
        <p class="label">WhatsApp</p>
        <a class="link" href={wa} target="_blank" rel="noopener noreferrer">+1 (813) 568 6424</a>
      </div>
      <div data-reveal style="--i:5">
        <p class="label">Ubicación</p>
        <p>Tampa, Florida · Online</p>
      </div>
      <div data-reveal style="--i:6">
        <p class="label">Redes</p>
        <ul class="contact__social">
          {socials.map((s) => <li><a class="link" href={s.href} target="_blank" rel="noopener noreferrer">{s.label}</a></li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .contact__inner {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 24px;
  }
  .contact__lede { color: var(--fg-muted); }
  .contact__mail {
    justify-self: start;
    font-size: clamp(1.5rem, 4.4vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.025em;
    line-height: 1.05;
    overflow-wrap: anywhere;
    margin-top: clamp(24px, 4vw, 56px);
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0% 2px;
    background-repeat: no-repeat;
    background-position: left bottom;
    padding-bottom: 0.08em;
    transition: background-size var(--dur-base) var(--ease-out);
  }
  .contact__mail:hover,
  .contact__mail:focus-visible { background-size: 100% 2px; }
  .contact__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 32px;
    margin-top: clamp(40px, 6vw, 88px);
    padding-top: 32px;
    border-top: 1px solid var(--rule);
  }
  .contact__grid > div {
    grid-column: span 4;
    display: grid;
    gap: 10px;
    justify-items: start;
  }
  .contact__social {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  @media (max-width: 899px) {
    .contact__grid > div { grid-column: 1 / -1; }
  }
</style>

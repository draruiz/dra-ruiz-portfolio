---
import "../styles/global.css";
import Preloader from "../components/Preloader.astro";
import Nav from "../components/Nav.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  navSurface?: "noche" | "papel" | "rubor" | "tension";
}

const siteUrl = "https://draruiz.com";
const {
  title,
  description = "Dra. María Alejandra Ruiz, psicóloga clínica con más de 20 años de experiencia. Autora, conferencista y fundadora de Almaymente.io y Healthy Mind Specialists.",
  ogImage = `${siteUrl}/og-image.jpg`,
  navSurface = "noche",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, siteUrl).href;

const ldPerson = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Dra. María Alejandra Ruiz",
  jobTitle: "Psicóloga Clínica",
  url: siteUrl,
  image: `${siteUrl}/og-image.jpg`,
  description:
    "Psicóloga clínica, autora y conferencista. Fundadora de Healthy Mind Specialists y CEO de Almaymente.io.",
  knowsAbout: ["Psicología Clínica", "Apego", "Ansiedad", "Dependencia emocional", "Salud mental"],
  sameAs: [
    "https://www.instagram.com/dramariaalejandraruiz/",
    "https://www.linkedin.com/in/drmarialejandraruiz",
    "https://www.youtube.com/@Pensandoenvozaltadraruiz",
    "https://open.spotify.com/show/7EAPPcMUumoRKNNJd44f6k",
  ],
  worksFor: { "@type": "Organization", name: "Almaymente.io", url: "https://almaymente.io" },
};
const ldSite = { "@context": "https://schema.org", "@type": "WebSite", name: "Dra. María Alejandra Ruiz", url: siteUrl };
const ldBook = {
  "@context": "https://schema.org",
  "@type": "Book",
  name: "El niño que fui, el adulto que elijo ser",
  author: { "@type": "Person", name: "Dra. María Alejandra Ruiz" },
  bookEdition: "Segunda edición",
  inLanguage: "es",
};
const ldPodcast = {
  "@context": "https://schema.org",
  "@type": "PodcastSeries",
  name: "Dilo Como Es",
  url: "https://open.spotify.com/show/7EAPPcMUumoRKNNJd44f6k",
  inLanguage: "es",
  author: { "@type": "Person", name: "Dra. María Alejandra Ruiz" },
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Dra. María Alejandra Ruiz" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Dra. María Alejandra Ruiz" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="generator" content={Astro.generator} />

    <link rel="preload" href="/fonts/century-gothic-700.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/century-gothic-400.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/amoresa.woff" as="font" type="font/woff" crossorigin />

    <script is:inline>document.documentElement.classList.add("js");</script>

    <script type="application/ld+json" set:html={JSON.stringify(ldPerson)} />
    <script type="application/ld+json" set:html={JSON.stringify(ldSite)} />
    <script type="application/ld+json" set:html={JSON.stringify(ldBook)} />
    <script type="application/ld+json" set:html={JSON.stringify(ldPodcast)} />
  </head>
  <body>
    <!--
    DIRECCIÓN · Hilo Rojo / Índice editorial · seed d15e204a (impeccable, surface, persuade)
    THESIS: La home es una tabla de contenidos gigante unida por un solo hilo rojo que se dibuja al hacer scroll. Refusa el hero centrado con tarjetas de servicios.
    OWN-WORLD: Crema, negro, rosa y rojo #AA1C1A en cuatro superficies que alternan por corte limpio; Century Gothic 700 como imagen y 400 para leer; Amoresa una palabra por pantalla; filetes 1px, píldoras, arco mid-century; un hilo SVG continuo por sección, con punto de encuentro en cada CTA.
    STORY: En segundos el visitante sabe quién es (psicóloga clínica, vínculos), ve en el índice todo lo que hace y va a los cursos de Almaymente o escribe por WhatsApp.
    FIRST VIEWPORT: Video a sangre oscurecido; nav transparente con píldora "Cursos"; nombre en display-1 anclado abajo-izquierda en 8 columnas con "dra" y "R" en script; a la derecha rol, una frase y el CTA primario; el hilo rojo cruza detrás del nombre y sale abajo a la derecha hacia el índice.
    FORM: Índice editorial, #3 de 7 estructuras, elegido por el cliente sobre la mano d15e204a.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance.
    -->
    <a class="skip" href="#contenido">Ir al contenido</a>
    <Preloader />
    <Nav surface={navSurface} />
    <slot />
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>

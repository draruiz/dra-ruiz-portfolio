---
import "../styles/global.css";
import Preloader from "../components/Preloader.astro";
import Nav from "../components/Nav.astro";
import { ALMA_Y_MENTE, PORTRAIT_URL } from "../consts";

interface Props {
  title: string;
  description?: string;
  /** Otra tarjeta para compartir (URL absoluta); por defecto, `public/og-image.jpg`. */
  ogImage?: string;
  ogImageAlt?: string;
  /** `ProfilePage` en las páginas sobre ella (inicio, "Mi historia"); `WebPage` en el resto. */
  pageType?: "ProfilePage" | "WebPage";
  navSurface?: "noche" | "papel" | "rubor" | "tension";
}

// El dominio sale de `site` (astro.config.mjs): canónica, tarjeta, sitemap y robots.txt lo comparten.
if (!Astro.site) throw new Error("Falta `site` en astro.config.mjs");
const siteUrl = new URL("/", Astro.site).href;
const defaultOgImage = new URL("/og-image.jpg", Astro.site).href;

const {
  title,
  description = "Dra. María Alejandra Ruiz, psicóloga clínica con más de 10 años de experiencia. Autora, conferencista y fundadora de Almaymente.io y Healthy Mind Specialists.",
  ogImage = defaultOgImage,
  ogImageAlt = "Dra. María Alejandra Ruiz: psicóloga clínica, autora y conferencista. Vínculos, apego y salud mental, en español.",
  pageType = "WebPage",
  navSurface = "noche",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;

// Datos estructurados (schema.org): un solo grafo con `@id`, así buscadores y
// asistentes de IA leen a una persona —la misma que almaymente.io nombra como
// fundadora— con su clínica, su libro, su podcast y esta página. Solo hechos
// que el sitio ya cuenta.
const person = { "@id": `${siteUrl}#person` };
const website = { "@id": `${siteUrl}#website` };
const podcastUrl = "https://open.spotify.com/show/7EAPPcMUumoRKNNJd44f6k";
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      ...person,
      name: "Dra. María Alejandra Ruiz",
      jobTitle: "Psicóloga clínica",
      url: siteUrl,
      image: PORTRAIT_URL,
      description:
        "Psicóloga clínica, autora y conferencista. Fundadora de Healthy Mind Specialists y CEO de Almaymente.io.",
      knowsAbout: ["Psicología clínica", "Apego", "Ansiedad", "Dependencia emocional", "Salud mental"],
      birthPlace: { "@type": "Place", name: "Medellín, Colombia" },
      alumniOf: { "@type": "CollegeOrUniversity", name: "Rutgers University" },
      worksFor: ALMA_Y_MENTE,
      sameAs: [
        "https://www.instagram.com/dramariaalejandraruiz/",
        "https://www.linkedin.com/in/drmarialejandraruiz",
        "https://www.youtube.com/@Pensandoenvozaltadraruiz",
        podcastUrl,
      ],
    },
    {
      "@type": "MedicalOrganization",
      name: "Healthy Mind Specialists",
      description: "Clínica de ansiedad en Tampa, Florida.",
      founder: person,
      address: { "@type": "PostalAddress", addressLocality: "Tampa", addressRegion: "FL", addressCountry: "US" },
    },
    {
      "@type": "WebSite",
      ...website,
      url: siteUrl,
      name: "Dra. María Alejandra Ruiz",
      inLanguage: "es",
      publisher: person,
      about: person,
    },
    {
      "@type": pageType,
      "@id": `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: title,
      description,
      inLanguage: "es",
      isPartOf: website,
      ...(pageType === "ProfilePage" ? { mainEntity: person } : { about: person }),
    },
    {
      "@type": "Book",
      name: "El niño que fui, el adulto que elijo ser",
      author: person,
      bookEdition: "Segunda edición",
      inLanguage: "es",
    },
    {
      "@type": "PodcastSeries",
      name: "Dilo Como Es",
      url: podcastUrl,
      inLanguage: "es",
      author: person,
    },
  ],
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="Dra. María Alejandra Ruiz" />
    <meta name="theme-color" content="#000000" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      ogImage === defaultOgImage && (
        <>
          <meta property="og:image:type" content="image/jpeg" />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
        </>
      )
    }
    <meta property="og:locale" content="es_LA" />
    <meta property="og:site_name" content="Dra. María Alejandra Ruiz" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    <meta name="generator" content={Astro.generator} />

    <link rel="preload" href="/fonts/century-gothic-700.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/century-gothic-400.woff" as="font" type="font/woff" crossorigin />
    <link rel="preload" href="/fonts/amoresa.woff" as="font" type="font/woff" crossorigin />

    <script is:inline>document.documentElement.classList.add("js");</script>

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <!--
    DIRECCIÓN · Hilo Rojo / Índice editorial · seed d15e204a (impeccable, surface, persuade)
    THESIS: La home es una tabla de contenidos gigante unida por un solo hilo rojo que se dibuja al hacer scroll. Refusa el hero centrado con tarjetas de servicios.
    OWN-WORLD: Crema, negro, rosa y rojo #AA1C1A en cuatro superficies que alternan por corte limpio; Century Gothic 700 como imagen y 400 para leer; Amoresa una palabra por pantalla; filetes 1px, píldoras, arco mid-century; un hilo SVG continuo por sección, con punto de encuentro en cada CTA.
    STORY: En segundos el visitante sabe quién es (psicóloga clínica, vínculos), ve en el índice todo lo que hace y va a los cursos de Almaymente o escribe por WhatsApp.
    FIRST VIEWPORT: Video a sangre oscurecido; nav transparente con píldora "Cursos"; nombre en display-1 anclado abajo-izquierda en 8 columnas con "dra" y "R" en script; a la derecha rol, una frase y el CTA primario; el hilo rojo cruza detrás del nombre y sale abajo a la derecha hacia el índice.
    FORM: Índice editorial, #3 de 7 estructuras, elegido por el cliente sobre la mano d15e204a.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, DESIGN.md, and every shipping raster carrying its provenance.
    -->
    <a class="skip" href="#contenido">Ir al contenido</a>
    <Preloader />
    <Nav surface={navSurface} />
    <slot />
    <script>
      import "../scripts/motion.ts";
    </script>
  </body>
</html>

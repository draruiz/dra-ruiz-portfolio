---
import { Image } from "astro:assets";
import Footer from "../components/Footer.astro";
import Thread from "../components/Thread.astro";
import Layout from "../layouts/Layout.astro";
import { PORTRAIT_URL as portrait } from "../consts";


const paragraphs = [
  "Soy psicóloga clínica. Mi camino en la psicología ha sido tan fascinante como las mentes que he acompañado hacia la autorreflexión y el crecimiento.",
  "Nací en Medellín, Colombia, y comencé mi viaje académico con la determinación de comprender las complejidades de la mente humana. Me formé en Estados Unidos, donde culminé mi pregrado en psicología en Rutgers University, en New Jersey.",
  "Allí adquirí la base teórica y trabajé con el departamento de justicia en la creación de métodos de intervención que permitieron conceptualizar los nexos emocionales y desarrollar la confianza en niños que habían sufrido abandono, abuso y negligencia grave.",
  "Después de obtener mi maestría y doctorado en psicología clínica en el estado de Florida, apliqué esas habilidades en entornos clínicos e investigativos, uniendo la teoría a la práctica. La experiencia en prisiones de máxima seguridad me dio una comprensión profunda de cómo la falta de regulación emocional y las relaciones traumáticas afectan a las personas.",
  "Fundé Healthy Mind Specialists, la clínica de ansiedad en Tampa, Florida. Más allá de la consulta privada, he sido una voz activa en la divulgación y la educación en salud mental, compartiendo herramientas prácticas para el bienestar emocional en conferencias y programas educativos.",
  "Hoy me acompaña un grupo de terapeutas expertos de habla hispana que ha tenido un gran impacto en cientos de personas en más de 20 países.",
  "Estoy a punto de publicar un nuevo libro que aborda las heridas de la infancia y el apego emocional, en un cruce entre la teoría psicológica y la experiencia humana.",
  "Mi obra refleja no solo el conocimiento académico sobre las conexiones, sino la sabiduría de una carrera dedicada a comprender y alimentar los vínculos humanos.",
  "Mi meta más ambiciosa es establecer programas de mentoría a nivel internacional para guiar a terapeutas en formación en Latinoamérica, y que así muchos más profesionales cuenten con los recursos para ayudar a miles de personas a transitar sus problemas de vínculo afectivo y apego emocional.",
];

const milestones = [
  {
    k: "Medellín",
    v: "Nace en Colombia con la vocación de comprender la mente humana.",
  },
  {
    k: "Rutgers",
    v: "Pregrado en psicología y trabajo con el departamento de justicia.",
  },
  { k: "Florida", v: "Maestría y doctorado en psicología clínica." },
  { k: "Wisconsin", v: "Especialización en prisiones de máxima seguridad." },
  { k: "Tampa", v: "Funda Healthy Mind Specialists, la clínica de ansiedad." },
  {
    k: "Global",
    v: "Equipo de terapeutas hispanohablantes en más de 20 países.",
  },
  { k: "Hoy", v: "Nuevo libro sobre heridas de infancia y apego emocional." },
];
---

<Layout
  title='Mi historia · Dra. María Alejandra Ruiz'
  pageType='ProfilePage'
  description='De Medellín a Tampa: la historia de la Dra. María Alejandra Ruiz, psicóloga clínica, autora y conferencista dedicada a los vínculos y la salud mental.'
  navSurface='papel'
>
  <main id='contenido'>
    <section
      class='ahero section'
      data-surface='papel'
      aria-labelledby='about-heading'
    >
      <Thread
        class='ahero__thread'
        draw='hero'
        d='M -20 700 C 300 560, 520 820, 820 640 C 1000 520, 700 880, 300 910'
        dm='M -20 700 C 300 560, 520 820, 820 640 C 1000 520, 700 880, 40 910'
      />
      <div class='container ahero__grid'>
        <p class='kicker kicker--rule' data-hero>Mi historia</p>
        <h1 id='about-heading' class='display-1 ahero__title' data-hero>
          Comprender y cuidar las <span class='script'>conexiones</span> humanas
        </h1>
        <p class='body-lg ahero__lede' data-hero>
          Psicóloga clínica · Autora · Conferencista · Medellín → Tampa
        </p>
      </div>
    </section>

    <section
      class='abio section'
      data-surface='papel'
      aria-labelledby='abio-heading'
    >
      <Thread
        class='abio__thread'
        draw='scrub'
        d='M 300 -10 C 300 200, 520 320, 480 520 S 80 700, 80 910'
        dm='M 40 -10 C 40 300, 88 500, 88 910'
      />
      <div class='container abio__grid'>
        <figure class='abio__figure arch' data-reveal>
          <Image
            src={portrait}
            alt='Retrato en blanco y negro de la Dra. María Alejandra Ruiz'
            width={640}
            height={800}
            loading='eager'
            decoding='async'
          />
          <figcaption class='caption'>
            Dra. María Alejandra Ruiz · Tampa, Florida
          </figcaption>
        </figure>
        <div class='abio__text'>
          <h2 id='abio-heading' class='sr-only'>Biografía completa</h2>
          {
            paragraphs.map((p, i) => (
              <p class={i === 0 ? "body-lg" : undefined} data-reveal>
                {p}
              </p>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class='ruta section'
      data-surface='rubor'
      aria-labelledby='ruta-heading'
    >
      <Thread
        class='ruta__thread'
        variant='stitch'
        draw='clip'
        width={1}
        d='M 80 -10 L 80 910'
        dm='M 88 -10 L 88 910'
      />
      <div class='container ruta__grid'>
        <header class='ruta__head'>
          <p class='kicker kicker--rule' data-reveal>Ruta</p>
          <h2 id='ruta-heading' class='display-2' data-reveal style='--i:1'>
            Un camino de <span class='script'>transformación</span>
          </h2>
        </header>
        <ol class='ruta__list'>
          {
            milestones.map((m, i) => (
              <li data-reveal style={`--i:${Math.min(i, 5)}`}>
                <span class='ruta__k h3'>{m.k}</span>
                <span class='ruta__v'>{m.v}</span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section
      class='acta section'
      data-surface='noche'
      aria-labelledby='acta-heading'
    >
      <Thread
        class='acta__thread'
        draw='scrub'
        d='M 80 -10 C 80 260, 600 420, 1180 420'
        dm='M 88 -10 C 88 200, 40 300, 40 500'
        dot={{ cx: 1180, cy: 420 }}
        anchor='.acta__actions .btn--primary'
      />
      <div class='container acta__grid'>
        <h2 id='acta-heading' class='display-2' data-reveal>
          ¿Quieres saber más sobre mi trabajo?
        </h2>
        <div class='acta__actions' data-reveal style='--i:1'>
          <a
            class='btn btn--primary'
            href='https://almaymente.io'
            target='_blank'
            rel='noopener noreferrer'>Ver los cursos</a
          >
          <a class='btn btn--secondary' href='/#libro'>El libro</a>
          <a class='btn btn--secondary' href='/#podcast'>Podcast</a>
          <a class='link' href='/#contacto'>Contacto</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>

<style>
  .ahero {
    padding-top: calc(var(--nav-h) + clamp(64px, 12vh, 140px));
    padding-bottom: clamp(48px, 7vw, 96px);
  }
  .ahero__grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 28px;
  }
  .ahero__title {
    max-width: 14ch;
    font-size: clamp(3rem, 8.5vw, 7.5rem);
  }
  .ahero__lede {
    color: var(--fg-muted);
  }
  :global(.js) [data-hero] {
    opacity: 0;
    transform: translateY(24px);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-hero] {
      opacity: 1;
      transform: none;
    }
  }

  .abio {
    padding-top: 0;
  }
  .abio__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 48px;
    align-items: start;
  }
  .abio__figure {
    grid-column: 1 / span 4;
    z-index: 0;
    position: sticky;
    top: calc(var(--nav-h) + 32px);
    display: grid;
    gap: 14px;
  }
  .abio__text {
    grid-column: 6 / -1;
    position: relative;
    z-index: 2;
    display: grid;
    gap: 28px;
  }
  .abio__text p {
    color: var(--fg-muted);
    max-width: 38rem;
  }
  .abio__text p.body-lg {
    color: var(--fg);
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    line-height: 1.4;
  }

  .ruta__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
    row-gap: 56px;
  }
  .ruta__head {
    grid-column: 2 / span 10;
    position: relative;
    z-index: 2;
    display: grid;
    gap: 24px;
  }
  .ruta__list {
    grid-column: 2 / span 10;
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0;
    border-top: 1px solid var(--rule);
  }
  .ruta__list li {
    position: relative;
    display: grid;
    grid-template-columns: minmax(8rem, 1fr) 3fr;
    column-gap: var(--gap);
    padding-block: 22px;
    border-bottom: 1px solid var(--rule);
  }
  .ruta__list li::before {
    content: "";
    position: absolute;
    left: calc(-1 * var(--gap) - 4px);
    top: 34px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--thread);
  }
  .ruta__v {
    color: var(--fg-muted);
    max-width: 32rem;
  }

  .acta__grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 40px;
  }
  .acta__grid .display-2 {
    max-width: 16ch;
  }
  .acta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 20px;
  }

  @media (max-width: 899px) {
    .abio__figure {
      grid-column: 1 / span 8;
      position: relative;
      top: auto;
    }
    .abio__text {
      grid-column: 1 / -1;
    }
    .ruta__head,
    .ruta__list {
      grid-column: 1 / -1;
    }
    .ruta__list li {
      grid-template-columns: 1fr;
      row-gap: 6px;
      padding-left: 20px;
    }
    .ruta__list li::before {
      left: 0;
      top: 30px;
    }
  }
</style>
